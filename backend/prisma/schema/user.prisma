// User Model
enum Role {
  STUDENT
  ADMIN
  SECURITY_STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role   @default(STUDENT)

  department      String?
  year            Int?
  profileImageUrl String?
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)

  // One to Many Relationship between User and Item
  postedItems Item[]

  claims Claim[]

  ConversationUser1 Conversation[] @relation("ConversationUser1")
  ConversationUser2 Conversation[] @relation("ConversationUser2")

  sentMessages Message[]

  notifications Notification[]

  reportsMade    Report[] @relation("Reporter")
  reportsAgainst Report[] @relation("ReportedUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
