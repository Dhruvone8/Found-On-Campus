enum VerificationPurpose {
  REGISTRATION
  PASSWORD_RESET
}

model Verification {
  id         String              @id @default(uuid())
  email      String
  otpHash    String
  purpose    VerificationPurpose
  expiresAt  DateTime
  attempts   Int                 @default(0)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, purpose])
}
